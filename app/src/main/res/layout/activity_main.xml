<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gharb_bg"
    android:layoutDirection="rtl">

    <!-- الشريط العلوي (Top Toolbar) -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/gharb_surface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- اسم المنصة -->
        <TextView
            android:id="@+id/tvPlatformTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="gharb studi app"
            android:textColor="@color/gharb_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- مفتاح تبديل الوضع (Online / Offline Toggle) -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchOnlineMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:checked="true"
            android:text="متصل"
            android:textColor="@color/gharb_primary"
            android:textSize="11sp"
            app:thumbTint="@color/gharb_primary"
            app:trackTint="@color/gharb_surface_elevated" />

        <!-- زر الإعدادات (Settings) -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="الإعدادات"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@color/gharb_text_primary" />

        <!-- زر القائمة المنسدلة (Corner Dropdown Menu) -->
        <ImageButton
            android:id="@+id/btnCornerMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="خيارات الملف"
            android:src="@android:drawable/ic_menu_more"
            app:tint="@color/gharb_text_primary" />
    </LinearLayout>

    <!-- شريط مؤشر الصفحات الثلاث للتنقل السريع بجانب السحب -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/pageTabIndicator"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@color/gharb_surface"
        app:layout_constraintTop_toBottomOf="@id/topToolbar"
        app:tabIndicatorColor="@color/gharb_primary"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="@color/gharb_primary"
        app:tabTextColor="@color/gharb_text_secondary" />

    <!-- منطقة الصفحات القابلة للسحب (ViewPager2) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintTop_toBottomOf="@id/pageTabIndicator" />

    <!-- شريط التنقل السفلي المخصص (Custom Bottom Navigation Bar) -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/gharb_surface"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- زر الرجوع (Back) -->
        <LinearLayout
            android:id="@+id/btnNavBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/gharb_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="رجوع"
                android:textColor="@color/gharb_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- زر الوسط الرئيسي (Home / Studio) -->
        <LinearLayout
            android:id="@+id/btnNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="32dp"
                android:background="@color/gharb_primary"
                android:padding="4dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="@color/gharb_bg" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="الاستوديو"
                android:textColor="@color/gharb_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- زر الخيارات (Options) -->
        <LinearLayout
            android:id="@+id/btnNavOptions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/gharb_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="الخيارات"
                android:textColor="@color/gharb_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
