<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gharb_surface"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إدارة المهارات والدوال ومشاريع ZIP المحلية"
        android:textColor="@color/gharb_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etSkillName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@color/gharb_editor_bg"
        android:hint="اسم المهارة أو الدالة (مثال: دالة اتصال API)"
        android:paddingHorizontal="12dp"
        android:textColor="@color/gharb_text_primary"
        android:textColorHint="@color/gharb_text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etSkillCode"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="8dp"
        android:background="@color/gharb_editor_bg"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:hint="كود المهارة أو الدالة لحفظها محلياً..."
        android:padding="10dp"
        android:textColor="#A7F3D0"
        android:textColorHint="@color/gharb_text_secondary"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnImportSkillZip"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:text="استيراد حزمة مهارات أو مشروع ZIP وتخزينه محلياً"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvStoredSkillsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="المهارات المخزنة محلياً: 0"
        android:textColor="@color/gharb_text_secondary"
        android:textSize="12sp" />

</LinearLayout>
