<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gharb_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- شريط اختيار اللغة -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHtml"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="HTML" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCss"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CSS" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipJs"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JS" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipKotlin"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kotlin" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- أزرار إضافة المهارات ونقاط الاستعادة ومساعد الذكاء الاصطناعي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddSkillsZip"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="مهارات / ZIP"
            android:textColor="@color/gharb_accent"
            android:textSize="11sp"
            app:strokeColor="@color/gharb_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSnapshots"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="نقاط الاستعادة (0)"
            android:textColor="@color/gharb_warning"
            android:textSize="11sp"
            app:strokeColor="@color/gharb_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenAiAssistant"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="@color/gharb_primary"
            android:text="مساعد الذكاء AI"
            android:textColor="@color/gharb_bg"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- مكتبة القوالب والمهارات المدمجة (تعمل بدون إنترنت) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="مكتبة القوالب والمهارات المدمجة (بدون إنترنت):"
        android:textColor="@color/gharb_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutBuiltInLibrary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTplCalc"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="قالب آلة حاسبة"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTplTodo"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="قالب مهام يومية"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTplStore"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="قالب متجر مصغر"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTplConverter"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="قالب محول وحدات"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkillOfflineStorage"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="مهارة التخزين المحلي"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- محرر الأكواد اليدوي مع ترقيم الأسطر -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@color/gharb_editor_bg"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <ScrollView
            android:id="@+id/scrollLineNumbers"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:background="@color/gharb_editor_gutter"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvLineNumbers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:paddingHorizontal="6dp"
                android:paddingVertical="10dp"
                android:text="1"
                android:textColor="@color/gharb_text_secondary"
                android:textSize="13sp" />
        </ScrollView>

        <ScrollView
            android:id="@+id/scrollCodeEditor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <EditText
                android:id="@+id/etCodeEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:hint="اكتب الكود هنا أو اختر قالباً من المكتبة المدمجة..."
                android:inputType="textMultiLine|textNoSuggestions"
                android:minHeight="320dp"
                android:padding="10dp"
                android:textColor="#A7F3D0"
                android:textColorHint="@color/gharb_text_secondary"
                android:textSize="13sp" />
        </ScrollView>
    </LinearLayout>

    <!-- شريط حالة المحرر ومحلل الكود السفلي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvEditorStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="HTML • 1 أسطر"
            android:textColor="@color/gharb_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvAiModeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="وضع AI: Gemini متصل"
            android:textColor="@color/gharb_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutCodeLinterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@color/gharb_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvCodeLinterSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="محلل الكود: الكود سليم (0 أخطاء)"
            android:textColor="@color/gharb_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="عرض التفاصيل"
            android:textColor="@color/gharb_accent"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
