<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gharb_surface"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="التحكم في الإصدارات (نقاط الاستعادة)"
        android:textColor="@color/gharb_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="احفظ نسخة محلية من أكواد المشروع قبل أي تعديل كبير للعودة إليها بضغطة زر."
        android:textColor="@color/gharb_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSnapshotName"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@color/gharb_editor_bg"
            android:hint="اسم نقطة الاستعادة (مثال: قبل تعديل الواجهة)"
            android:paddingHorizontal="12dp"
            android:textColor="@color/gharb_text_primary"
            android:textColorHint="@color/gharb_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCreateSnapshot"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="@color/gharb_primary"
            android:text="حفظ نقطة"
            android:textColor="@color/gharb_bg"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="12dp"
        android:background="@color/gharb_editor_bg"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/layoutSnapshotsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
