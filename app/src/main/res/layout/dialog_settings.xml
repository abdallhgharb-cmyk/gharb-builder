<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gharb_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إعدادات gharb studi app"
            android:textColor="@color/gharb_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="حجم خط المحرر (sp):"
            android:textColor="@color/gharb_text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etSettingsFontSize"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@color/gharb_editor_bg"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:text="13"
            android:textColor="@color/gharb_text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="مسار الحفظ المحلي (Save Path):"
            android:textColor="@color/gharb_text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etSettingsSavePath"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@color/gharb_editor_bg"
            android:paddingHorizontal="12dp"
            android:text="/storage/emulated/0/GharbStudiProjects"
            android:textColor="@color/gharb_text_primary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/gharb_editor_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مفتاح Gemini 4 Hydrogen API"
                android:textColor="@color/gharb_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="أدخل مفتاح API الخاص بـ Gemini 4 لتشغيل الذكاء الاصطناعي مباشرة من التطبيق (اختياري)."
                android:textColor="@color/gharb_text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etSettingsGeminiKey"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@color/gharb_surface"
                    android:fontFamily="monospace"
                    android:hint="AIzaSy..."
                    android:inputType="textPassword"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/gharb_text_primary"
                    android:textColorHint="@color/gharb_text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnToggleGeminiKey"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#1E293B"
                    android:text="إظهار"
                    android:textColor="@color/gharb_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- قسم مصنع البناء السحابي عبر GitHub Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/gharb_editor_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مصنع البناء السحابي (GitHub Actions)"
                android:textColor="@color/gharb_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="الإعدادات الافتراضية مدمجة ومفعّلة مسبقاً لتجميع APK الحقيقي تلقائياً، ويمكنك تعديلها لمستودعك الخاص."
                android:textColor="@color/gharb_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="اسم مستخدم GitHub والمستودع (Owner / Repo):"
                android:textColor="@color/gharb_text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etSettingsGithubRepo"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@color/gharb_surface"
                android:fontFamily="monospace"
                android:hint="owner/repo"
                android:inputType="textNoSuggestions"
                android:paddingHorizontal="12dp"
                android:textColor="@color/gharb_text_primary"
                android:textColorHint="@color/gharb_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="رمز الوصول الشخصي (GitHub Token):"
                android:textColor="@color/gharb_text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etSettingsGithubToken"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@color/gharb_surface"
                android:fontFamily="monospace"
                android:hint="ghp_..."
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:textColor="@color/gharb_text_primary"
                android:textColorHint="@color/gharb_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestoreDefaultCloudSettings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:text="استعادة إعدادات المصنع الافتراضية"
                android:textColor="@color/gharb_accent"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSettingsWordWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="التفاف الأسطر التلقائي في المحرر"
            android:textColor="@color/gharb_text_primary" />

    </LinearLayout>
</ScrollView>
