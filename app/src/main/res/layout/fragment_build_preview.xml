<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gharb_bg"
    android:layoutDirection="rtl"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إعدادات البناء والتوقيع والمعاينة"
            android:textColor="@color/gharb_text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- بطاقة معاينة رابط الموقع الحقيقي إن وجد -->
        <LinearLayout
            android:id="@+id/layoutUrlPreviewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/gharb_surface"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="معاينة رابط الموقع المباشر (WebView)"
                android:textColor="@color/gharb_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPreviewUrlAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/gharb_text_secondary"
                android:textSize="11sp" />

            <WebView
                android:id="@+id/webViewInlineUrlPreview"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenUrlExternal"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:text="فتح في المتصفح الخارجي"
                android:textColor="@color/gharb_accent"
                app:strokeColor="@color/gharb_accent" />
        </LinearLayout>

        <!-- أزرار اختيار النظام المستهدف -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="النظام المستهدف:"
            android:textColor="@color/gharb_text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleTargetOs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:checkedButton="@id/btnTargetApk"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTargetApk"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Android (APK)"
                android:textColor="@color/gharb_text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTargetIpa"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="iOS (IPA)"
                android:textColor="@color/gharb_text_primary" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- قائمة ملفات المشروع المستخرجة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/gharb_surface"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvExtractedFilesHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="قائمة ملفات المشروع المستخرجة"
                android:textColor="@color/gharb_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:text="اضغط على أي ملف للتعديل اليدوي أو اطلب التعديل بالذكاء الاصطناعي."
                android:textColor="@color/gharb_text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/layoutExtractedFilesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- رفع أيقونة التطبيق -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/gharb_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivAppIconPreview"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@color/gharb_surface_elevated"
                android:padding="8dp"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="أيقونة التطبيق"
                    android:textColor="@color/gharb_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvIconStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الأيقونة الافتراضية"
                    android:textColor="@color/gharb_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadAppIcon"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="رفع أيقونة"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- حقول تخصيص التطبيق -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="اسم التطبيق (App Name)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAppName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تطبيقي الجديد"
                android:textColor="@color/gharb_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="اسم الحزمة (Package Name)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPackageName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textNoSuggestions"
                android:text="com.gharb.myapp"
                android:textColor="@color/gharb_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Version Name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVersionName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1.0.0"
                    android:textColor="@color/gharb_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Version Code">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVersionCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="1"
                    android:textColor="@color/gharb_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- التوقيع الرقمي وشهادة Keystore -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/gharb_surface"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchDigitalSigning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="تفعيل التوقيع الرقمي (Digital Signing)"
                android:textColor="@color/gharb_text_primary"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutKeystoreFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/etKeystoreAlias"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@color/gharb_editor_bg"
                    android:hint="Keystore Alias (مثال: gharb_release_key)"
                    android:paddingHorizontal="12dp"
                    android:text="gharb_release_key"
                    android:textColor="@color/gharb_text_primary"
                    android:textColorHint="@color/gharb_text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etKeystorePassword"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/gharb_editor_bg"
                    android:hint="كلمة مرور شهادة Keystore"
                    android:inputType="textPassword"
                    android:paddingHorizontal="12dp"
                    android:text="gharb@2026"
                    android:textColor="@color/gharb_text_primary"
                    android:textColorHint="@color/gharb_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- حالة محلل الكود قبل التصدير -->
        <TextView
            android:id="@+id/tvBuildLintStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/gharb_surface"
            android:padding="12dp"
            android:text="فحص الكود: جاهز للتصدير (0 أخطاء)"
            android:textColor="@color/gharb_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- أزرار محاكي أندرويد وبدء البناء والتصدير -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLivePreview"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="محاكي أندرويد"
                android:textColor="@color/gharb_accent"
                app:strokeColor="@color/gharb_accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartBuildExport"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="@color/gharb_primary"
                android:text="إنشاء وتصدير APK"
                android:textColor="@color/gharb_bg"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- بطاقة حالة البناء والتصدير (Build & Export Status) -->
        <LinearLayout
            android:id="@+id/layoutBuildStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:background="@color/gharb_surface"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBuildStatusHeading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="حالة البناء والتصدير"
                    android:textColor="@color/gharb_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBuildProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0%"
                    android:textColor="@color/gharb_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbCloudBuildProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/gharb_primary" />

            <TextView
                android:id="@+id/tvCurrentBuildStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="في انتظار بدء البناء..."
                android:textColor="@color/gharb_accent"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvBuildStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="1. رفع المشروع وملف build_android.yml إلى GitHub"
                android:textColor="@color/gharb_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvBuildStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="2. تهيئة بيئة Gradle &amp; Android SDK في السحابة"
                android:textColor="@color/gharb_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvBuildStep3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="3. تجميع وتوقيع APK الحقيقي بشهادة Keystore"
                android:textColor="@color/gharb_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvBuildStep4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="4. جاهزية ملف APK الحقيقي للتحميل والتثبيت!"
                android:textColor="@color/gharb_text_secondary"
                android:textSize="12sp" />

            <!-- بطاقة تأكيد جاهزية ملف APK أو PWA للتحميل والتثبيت -->
            <LinearLayout
                android:id="@+id/layoutApkSuccessBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#064E3B"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSuccessBoxTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تم إنشاء ملف APK الحقيقي بنجاح!"
                    android:textColor="#A7F3D0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvApkFileDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:textColor="#ECFDF5"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPinOfflineShortcut"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/gharb_accent"
                    android:text="تثبيت على الشاشة الرئيسية الآن"
                    android:textColor="@color/gharb_bg"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadApkNow"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/gharb_primary"
                    android:text="تحميل وتثبيت APK الحقيقي"
                    android:textColor="@color/gharb_bg"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
