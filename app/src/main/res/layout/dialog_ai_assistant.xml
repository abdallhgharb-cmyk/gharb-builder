<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gharb_surface"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvAiDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="مساعد الذكاء الاصطناعي - gharb studi app"
        android:textColor="@color/gharb_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAiEngineStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="الوضع النشط: Gemini API (إنترنت)"
        android:textColor="@color/gharb_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etAiPromptInput"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="12dp"
        android:background="@color/gharb_editor_bg"
        android:gravity="top|start"
        android:hint="اكتب فكرة التطبيق أو الدالة المطلوب توليدها (مثال: اصنع لي آلة حاسبة علمية، متجر، قائمة مهام)..."
        android:padding="12dp"
        android:textColor="@color/gharb_text_primary"
        android:textColorHint="@color/gharb_text_secondary"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/progressAiGenerating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:visibility="gone" />

</LinearLayout>
