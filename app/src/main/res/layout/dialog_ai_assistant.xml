<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gharb_surface"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Chat Toolbar: Back from Chat, New Chat, API Key Settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnAiBackFromChat"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#1E293B"
            android:text="رجوع من الدردشة"
            android:textColor="@color/gharb_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnAiOpenSettings"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#1E293B"
            android:text="مفتاح API"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAiNewChat"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="@color/gharb_primary"
            android:text="إضافة دردشة جديدة"
            android:textColor="#052E16"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAiDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="مساحة البناء الذكية — Gemini 4 Hydrogen"
        android:textColor="@color/gharb_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAiEngineStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="الوضع النشط: Gemini 4 Hydrogen (متصل)"
        android:textColor="@color/gharb_text_secondary"
        android:textSize="11sp" />

    <!-- Sub-Tabs Switcher: Chat | Preview | Artifacts | Handling Trace -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAiTabChat"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/gharb_primary"
                android:text="الدردشة"
                android:textColor="#052E16"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAiTabPreview"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1E293B"
                android:text="المعاينة"
                android:textColor="@color/gharb_text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAiTabArtifacts"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1E293B"
                android:text="القطع الأثرية"
                android:textColor="@color/gharb_text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAiTabTrace"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#1E293B"
                android:text="كيف تم التعامل مع الرسالة"
                android:textColor="@color/gharb_text_primary"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <!-- Tab 1: Chat Messages -->
        <ScrollView
            android:id="@+id/layoutAiChatTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#090D16"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvAiChatHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="أهلاً بك في مساحة Gemini 4 Hydrogen! اكتب فكرتك أو أرفق ملفاً أو التقط صورة، وسيقوم المحرك بالتخطيط والتنفيذ وتحديث المحاكي مباشرة."
                android:textColor="#CBD5E1"
                android:textSize="13sp" />
        </ScrollView>

        <!-- Tab 2: Live WebView Preview -->
        <WebView
            android:id="@+id/webViewAiPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Tab 3: Artifacts & Execution Plan -->
        <ScrollView
            android:id="@+id/layoutAiArtifactsTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#090D16"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAiArtifactsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="ستظهر هنا خطط التنفيذ والقطع الأثرية فور إرسال أول طلب لـ Gemini 4."
                android:textColor="#CBD5E1"
                android:textSize="13sp" />
        </ScrollView>

        <!-- Tab 4: Request Handling Trace -->
        <ScrollView
            android:id="@+id/layoutAiTraceTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#090D16"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAiTraceContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="لم يتم إرسال رسالة بعد — عند إرسال الطلب ستظهر هنا تفاصيل معالجة النص والمرفقات خطوة بخطوة."
                android:textColor="#A7F3D0"
                android:textSize="13sp" />
        </ScrollView>
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progressAiGenerating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

    <!-- Attachment Strip -->
    <LinearLayout
        android:id="@+id/layoutAiAttachmentStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#0F172A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAiAttachmentsSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#38BDF8"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnAiClearAttachments"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:backgroundTint="#334155"
            android:text="مسح"
            android:textColor="@color/gharb_text_primary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Bottom Wide Composer Bar with + Menu, Expand Toggle, Wide Input, Send -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAiAttachMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/gharb_primary"
            android:padding="0dp"
            android:text="+"
            android:textColor="#052E16"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAiExpandComposer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#1E293B"
            android:padding="0dp"
            android:text="⤢"
            android:textColor="@color/gharb_text_primary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etAiPromptInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/gharb_editor_bg"
            android:gravity="top|start"
            android:hint="اكتب رسالتك أو طلب تعديل الكود..."
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="8"
            android:minHeight="48dp"
            android:padding="10dp"
            android:scrollbars="vertical"
            android:textColor="@color/gharb_text_primary"
            android:textColorHint="@color/gharb_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnAiSendPrompt"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/gharb_primary"
            android:text="إرسال"
            android:textColor="#052E16"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
